# Local development credentials only; use unique, generated secrets in production.
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=campusconnect
DATABASE_URL=postgresql://campusconnect:replace-with-a-strong-database-password@localhost:5432/campusconnect?schema=public

API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Generate independently, for example with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace-with-a-32-character-random-secret

WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-nextauth-secret
SEED_ADMIN_PASSWORD=change-this-local-seed-password

REDIS_URL=redis://localhost:6379
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusConnect <noreply@campusconnect.app>
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads
